# AI旅行规划助手 - 环境变量配置示例
# 使用方法：复制本文件为 .env，然后把你的真实API key填进去
# 注意：.env 文件包含密钥，绝不能上传到GitHub（已在.gitignore中忽略）

# DeepSeek API密钥（在 https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=sk-你的密钥粘贴到这里

# 使用的模型名称（默认即可）
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API 地址（默认即可，无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 可选的第三方 API（未配置时自动降级）=====

# 和风天气 API key（https://dev.qweather.com 注册获取）
# 未配置时使用演示天气数据
QWEATHER_API_KEY=

# 和风天气 API Host（控制台「API Host」获取的项目专属域名，如 https://abcxyz.qweatherapi.com）
# 与 QWEATHER_API_KEY 一起配置后即使用真实预报（V1 接口：经纬度 + X-QW-Api-Key 认证）
QWEATHER_API_HOST=

# 天气演示模式：auto=随机 / rain=强制有雨 / sunny=强制晴天
# 设 rain 可演示 Agent 的雨天行程调整能力
WEATHER_DEMO_MODE=auto

# 高德地图 API key（https://lbs.amap.com 注册获取）
# 未配置时用经纬度坐标计算距离兜底
AMAP_API_KEY=
